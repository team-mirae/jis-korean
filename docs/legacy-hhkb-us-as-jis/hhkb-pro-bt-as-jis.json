{
  "title": "HHKB Professional BT (US) as a JIS keyboard, for JIS Korean",
  "rules": [
    {
      "description": "HHKB Pro BT (US) as JIS: カタカナ, 英数, かな and ろ on tap, ¥ on \\ [required]",
      "manipulators": [
        {
          "type": "basic",
          "description": "Left ⌥: tap カタカナ (to Korean), hold ⌥",
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "japanese_pc_katakana"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 514,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Left ⌘: tap 英数 (to English), hold ⌘",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "japanese_eisuu"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 514,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Right ⌘: tap かな (to Japanese), hold ⌘",
          "from": {
            "key_code": "right_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_command"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "japanese_kana"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 514,
                  "is_keyboard": true
                }
              ]

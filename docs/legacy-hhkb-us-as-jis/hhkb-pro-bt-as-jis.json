          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 514,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "\\ (left of `): ¥",
          "from": {
            "key_code": "backslash",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {

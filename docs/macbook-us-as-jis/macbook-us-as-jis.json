{
  "title": "MacBook built-in keyboard (US) as a JIS keyboard, for JIS Korean",
  "rules": [
    {
      "description": "MacBook (US) as JIS: fn (🌐) or right ⌥ held is the Fn layer, with ¥ on -, ⌘⇧4 on I and Play/Pause on P [Fn]",
      "manipulators": [
        {
          "type": "basic",
          "description": "fn (🌐): held, the Fn layer; tapped alone, 🌐 as usual",
          "from": {
            "key_code": "fn",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "macbook_jis_fn",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "macbook_jis_fn",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "apple_vendor_top_case_key_code": "keyboard_fn"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Right ⌥: held, the Fn layer (a second Fn, where JIS keyboards have one)",
          "from": {
            "key_code": "right_option",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "macbook_jis_fn",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "macbook_jis_fn",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ]
        },
        {

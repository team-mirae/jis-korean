{
  "name": "jis-korean-web",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --manifest-path ../engine/Cargo.toml --release --target wasm32-unknown-unknown && node tools/copy-engine.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  }
}
